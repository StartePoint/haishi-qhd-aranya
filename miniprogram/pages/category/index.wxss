.layout {
  display: flex;
  height: 100vh;
  background: #f5f5f5;
}
.side {
  width: 180rpx;
  background: #f0f0f0;
  height: 100%;
}
.side-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
.side-item.active {
  background: #fff;
  color: #c45c26;
  font-weight: 600;
  position: relative;
}
.side-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  background: #c45c26;
}
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: #fff;
}
.subs {
  white-space: nowrap;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
  height: 80rpx;
  box-sizing: border-box;
}
.sub {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.sub.active {
  border-color: #c45c26;
  color: #c45c26;
}
.list {
  flex: 1;
  height: 0;
}
.empty {
  padding: 48rpx;
  text-align: center;
  color: #999;
}
