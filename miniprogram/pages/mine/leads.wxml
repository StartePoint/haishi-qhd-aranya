<view class="page">
  <view class="empty" wx:if="{{!loading && !list.length}}">暂无询价记录</view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row">
      <text class="name">{{item.productName}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="meta">数量 ×{{item.qty}}</view>
    <view class="meta">{{item.timeText}}</view>
  </view>
</view>
