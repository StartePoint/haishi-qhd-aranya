.card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #eee;
  flex-shrink: 0;
}
.meta {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: 28rpx;
  line-height: 1.4;
}
.price {
  margin-top: 12rpx;
  color: #c45c26;
  font-weight: 600;
}
.sub {
  margin-top: 6rpx;
  color: #999;
  font-size: 22rpx;
}
